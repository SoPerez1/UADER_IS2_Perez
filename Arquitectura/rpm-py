import sys
import math

# -------------------------------------------------
# Excepción personalizada
# -------------------------------------------------
class RPNError(Exception):
    """Error específico del evaluador RPN"""
    pass

# -------------------------------------------------
# Funciones de Soporte
# -------------------------------------------------
def is_number(token):
    try:
        float(token)
        return True
    except ValueError:
        return False

def handle_arithmetic(token, stack):
    if len(stack) < 2: raise RPNError("Pila insuficiente para operar")
    b = stack.pop()
    a = stack.pop()
    if token == "+": stack.append(a + b)
    elif token == "-": stack.append(a - b)
    elif token == "*": stack.append(a * b)
    elif token == "/":
        if b == 0: raise RPNError("División por cero")
        stack.append(a / b)

def handle_math_functions(token, stack):
    if len(stack) < 1: raise RPNError("Pila insuficiente")
    x = stack.pop()
    ops = {
        "sqrt": lambda v: math.sqrt(v),
        "log":  lambda v: math.log10(v),
        "ln":   lambda v: math.log(v),
        "ex":   lambda v: math.exp(v),
        "10x":  lambda v: 10 ** v,
        "1/x":  lambda v: 1/v if v != 0 else exec('raise(RPNError("División por cero"))'),
        "sin":  lambda v: math.sin(math.radians(v)),
        "cos":  lambda v: math.cos(math.radians(v)),
        "tg":   lambda v: math.tan(math.radians(v)),
        "CHS":  lambda v: -v
    }
    if token in ops:
        try:
            stack.append(ops[token](x))
        except (ZeroDivisionError, ValueError):
            raise RPNError("Error matemático (división por cero o dominio)")
    else:
        if token == "asin": stack.append(math.degrees(math.asin(x)))
        elif token == "acos": stack.append(math.degrees(math.acos(x)))
        elif token == "atg": stack.append(math.degrees(math.atan(x)))

def handle_stack_commands(token, stack):
    if token == "clear":
        stack.clear()
        return
    if len(stack) < 1: raise RPNError("Pila insuficiente")
    if token == "dup":
        stack.append(stack[-1])
    elif token == "drop":
        stack.pop()
    elif token == "swap":
        if len(stack) < 2: raise RPNError("Pila insuficiente")
        stack[-1], stack[-2] = stack[-2], stack[-1]

def handle_memory(token, stack, mem):
    if token == "STO":
        if len(stack) < 2: raise RPNError("Pila insuficiente para STO")
        idx = int(stack.pop())
        val = stack.pop()
        if not 0 <= idx <= 9: raise RPNError("Memoria inválida")
        mem[idx] = val
    elif token == "RCL":
        if len(stack) < 1: raise RPNError("Pila insuficiente para RCL")
        idx = int(stack.pop())
        if not 0 <= idx <= 9: raise RPNError("Memoria inválida")
        stack.append(mem[idx])

# -------------------------------------------------
# Función de Evaluación
# -------------------------------------------------
def evaluate(tokens):
    stack = []
    mem = [0.0] * 10
    constants = {"p": math.pi, "e": math.e, "j": (1 + math.sqrt(5)) / 2}

    for token in tokens:
        if is_number(token):
            stack.append(float(token))
        elif token in constants:
            stack.append(constants[token])
        elif token in "+-*/":
            handle_arithmetic(token, stack)
        elif token in {"dup", "swap", "drop", "clear"}:
            handle_stack_commands(token, stack)
        elif token in {"sqrt", "log", "ln", "ex", "10x", "1/x", "sin", "cos", "tg", "asin", "acos", "atg", "CHS"}:
            handle_math_functions(token, stack)
        elif token == "yx":
            if len(stack) < 2: raise RPNError("Pila insuficiente")
            b = stack.pop(); a = stack.pop()
            stack.append(a ** b)
        elif token in {"STO", "RCL"}:
            handle_memory(token, stack, mem)
        else:
            raise RPNError(f"Token inválido: {token}")

    if len(stack) != 1:
        raise RPNError("La pila no terminó con un solo valor")
    return stack[0]

# -------------------------------------------------
# Punto de entrada (Main)
# -------------------------------------------------
def main():
    try:
        if len(sys.argv) > 1:
            expr = " ".join(sys.argv[1:])
        else:
            expr = input("Ingrese expresión RPN: ")

        tokens = expr.split()
        if not tokens:
            return

        result = evaluate(tokens)
        
        if isinstance(result, float) and result.is_integer():
            print(int(result))
        else:
            print(result)

    except RPNError as e:
        print("Error:", e)
    except Exception as e:
        print(f"Error inesperado: {e}")

if __name__ == "__main__":
    main()